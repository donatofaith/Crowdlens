{
  "expo": {
    "name": "CrowdLens",
    "slug": "crowdlens",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "crowdlens",
    "userInterfaceStyle": "dark",
    "icon": "./assets/images/icon.png",
    "android": {
      "package": "com.donatofaith.crowdlens",
      "versionCode": 1,
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      }
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "plugins": [
      [
        "expo-dev-client",
        {
          "showMenuAtLaunch": false,
          "skipOnboarding": true
        }
      ],
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow CrowdLens to use your precise location to verify that you are at a mission site."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow CrowdLens to use your camera to capture live mission proof.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          },
          "backgroundColor": "#0A0A0B"
        }
      ],
      "expo-status-bar"
    ],
    "experiments": {
      "reactCompiler": true,
      "typedRoutes": true
    },
    "web": {
      "favicon": "./assets/images/favicon.png",
      "output": "static"
    }
  }
}
